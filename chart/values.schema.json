{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "rootcoz Helm values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" }
        }
      }
    },
    "route": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" },
        "timeout": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          }
        }
      }
    },
    "ai": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": { "type": "string" },
        "geminiApiKey": { "type": "string" },
        "anthropicApiKey": { "type": "string" },
        "vertex": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "projectId": { "type": "string" },
            "region": { "type": "string" },
            "serviceAccountKey": { "type": ["string", "object"] }
          }
        },
        "cursor": {
          "type": "object",
          "properties": {
            "apiKey": { "type": "string" },
            "authJson": { "type": ["string", "object"] }
          }
        }
      }
    },
    "datadog": {
      "type": "object",
      "properties": {
        "apiKey": { "type": "string" },
        "appKey": { "type": "string" }
      }
    },
    "sidecar": {
      "type": "object",
      "properties": {
        "agentDir": {
          "type": "object",
          "properties": {
            "modelsJson": { "type": ["string", "object"] },
            "authJson": { "type": ["string", "object"] },
            "settingsJson": { "type": ["string", "object"] },
            "env": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "additionalProperties": { "type": "string" }
            }
          }
        }
      }
    },
    "admin": {
      "type": "object",
      "properties": {
        "key": { "type": "string" }
      }
    },
    "encryptionKey": { "type": "string" },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string" },
        "storageClass": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "description": "Container resource requests/limits. Unknown keys are rejected (a typo like resources.limit silently rendered an invalid pod). Extended resources (nvidia.com/gpu) and hugepages-* are allowed. memory/ephemeral-storage must carry a unit: a bare number means bytes in Kubernetes.",
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "description": "Scheduling floor. Setting a key to \"\" omits it from the rendered pod.",
          "properties": {
            "cpu": {
              "description": "Quantity or bare number. \"\" omits the key.",
              "anyOf": [
                { "type": "number" },
                { "type": "string", "minLength": 1 },
                { "const": "" }
              ]
            },
            "memory": {
              "description": "Quantity with a unit. \"\" omits the key.",
              "type": "string",
              "anyOf": [
                { "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)$" },
                { "const": "" }
              ]
            },
            "ephemeral-storage": {
              "description": "Quantity with a unit. \"\" omits the key.",
              "type": "string",
              "anyOf": [
                { "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)$" },
                { "const": "" }
              ]
            }
          },
          "patternProperties": {
            "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?/[a-z0-9]([-a-z0-9]*[a-z0-9])?$": { "type": ["string", "number"], "minLength": 1 },
            "^hugepages-[0-9]+[KMGT]i$": { "type": ["string", "number"], "minLength": 1 }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "description": "Eviction/throttle ceiling. An ephemeral-storage limit here also caps the /tmp emptyDir at the same sizeLimit.",
          "properties": {
            "cpu": {
              "description": "Quantity or bare number. \"\" omits the key.",
              "anyOf": [
                { "type": "number" },
                { "type": "string", "minLength": 1 },
                { "const": "" }
              ]
            },
            "memory": {
              "description": "Quantity with a unit. \"\" omits the key.",
              "type": "string",
              "anyOf": [
                { "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)$" },
                { "const": "" }
              ]
            },
            "ephemeral-storage": {
              "description": "Quantity with a unit. \"\" omits the key.",
              "type": "string",
              "anyOf": [
                { "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)$" },
                { "const": "" }
              ]
            }
          },
          "patternProperties": {
            "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?/[a-z0-9]([-a-z0-9]*[a-z0-9])?$": { "type": ["string", "number"], "minLength": 1 },
            "^hugepages-[0-9]+[KMGT]i$": { "type": ["string", "number"], "minLength": 1 }
          }
        }
      }
    },
    "env": {
      "type": "object",
      "properties": {
        "xdgDataHome": { "type": "string" },
        "xdgConfigHome": { "type": "string" },
        "secureCookies": { "type": "string" },
        "publicBaseUrl": { "type": "string" },
        "metadataRulesFile": { "type": "string" },
        "recordTranscripts": { "type": "boolean" },
        "sidecarTranscriptsDir": { "type": "string" }
      }
    },
    "tuning": {
      "type": "object",
      "properties": {
        "logLevel": { "type": "string" }
      }
    },
    "imageStream": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string" },
        "namespace": { "type": "string" }
      }
    },
    "tests": {
      "type": "object",
      "properties": {
        "image": { "type": "string" }
      }
    },
    "alerts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string" },
        "schedule": { "type": "string" },
        "envLabel": { "type": "string" },
        "metricsUrl": { "type": "string" },
        "image": { "type": "string" },
        "slackSecretName": { "type": "string" },
        "slackSecretKey": { "type": "string" },
        "errorRatePercent": { "type": "integer" },
        "diskWarnPercent": { "type": "integer" },
        "diskCritPercent": { "type": "integer" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object", "description": "Free-form Kubernetes affinity block, rendered verbatim by the chart; not validated." }
  }
}

{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "rootcoz Helm values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" }
        }
      }
    },
    "route": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" },
        "timeout": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          }
        }
      }
    },
    "ai": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": { "type": "string" },
        "geminiApiKey": { "type": "string" },
        "anthropicApiKey": { "type": "string" },
        "vertex": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "projectId": { "type": "string" },
            "region": { "type": "string" },
            "serviceAccountKey": { "type": ["string", "object"] }
          }
        },
        "cursor": {
          "type": "object",
          "properties": {
            "apiKey": { "type": "string" },
            "authJson": { "type": ["string", "object"] }
          }
        }
      }
    },
    "datadog": {
      "type": "object",
      "properties": {
        "apiKey": { "type": "string" },
        "appKey": { "type": "string" }
      }
    },
    "sidecar": {
      "type": "object",
      "properties": {
        "agentDir": {
          "type": "object",
          "properties": {
            "modelsJson": { "type": ["string", "object"] },
            "authJson": { "type": ["string", "object"] },
            "settingsJson": { "type": ["string", "object"] },
            "env": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "additionalProperties": { "type": "string" }
            }
          }
        }
      }
    },
    "admin": {
      "type": "object",
      "properties": {
        "key": { "type": "string" }
      }
    },
    "encryptionKey": { "type": "string" },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string" },
        "storageClass": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "description": "Container resource requests/limits. Unknown keys are rejected (a typo like resources.limit silently rendered an invalid pod). Extended resources (nvidia.com/gpu, example.com/GPU_2 — the name after the slash is a Kubernetes qualified name, so uppercase, '_' and '.' are legal) and hugepages-* are allowed. Any value the Kubernetes Quantity grammar accepts is allowed, including a bare number: for memory/ephemeral-storage a unit-less value is bytes.",
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "description": "Scheduling floor. Setting a key to \"\" omits the explicit request, but the limit still becomes the effective request unless a LimitRange defaults one.",
          "properties": {
            "cpu": {
              "description": "Kubernetes quantity (500m, \"2.5\", 1e3) or a bare number of cores (4). \"\" omits the key.",
              "anyOf": [
                { "type": "number", "minimum": 0 },
                { "type": "string", "pattern": "^([0-9]+(\\.[0-9]*)?|\\.[0-9]+)([eE][-+]?[0-9]+|Ki|Mi|Gi|Ti|Pi|Ei|n|u|m|k|M|G|T|P|E)?$" },
                { "const": "" }
              ]
            },
            "memory": {
              "description": "Kubernetes quantity (4Gi, 512Mi, .5Gi) or a bare number, which Kubernetes reads as bytes. \"\" omits the key.",
              "anyOf": [
                { "type": "number", "minimum": 0 },
                { "type": "string", "pattern": "^([0-9]+(\\.[0-9]*)?|\\.[0-9]+)([eE][-+]?[0-9]+|Ki|Mi|Gi|Ti|Pi|Ei|n|u|m|k|M|G|T|P|E)?$" },
                { "const": "" }
              ]
            },
            "ephemeral-storage": {
              "description": "Kubernetes quantity (16Gi, 512Mi) or a bare number, which Kubernetes reads as bytes. \"\" omits the key.",
              "anyOf": [
                { "type": "number", "minimum": 0 },
                { "type": "string", "pattern": "^([0-9]+(\\.[0-9]*)?|\\.[0-9]+)([eE][-+]?[0-9]+|Ki|Mi|Gi|Ti|Pi|Ei|n|u|m|k|M|G|T|P|E)?$" },
                { "const": "" }
              ]
            }
          },
          "patternProperties": {
            "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/[A-Za-z0-9]([-_.A-Za-z0-9]*[A-Za-z0-9])?$": { "type": ["string", "number"], "minLength": 1 },
            "^hugepages-[0-9]+[KMGT]i$": { "type": ["string", "number"], "minLength": 1 }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "description": "Eviction/throttle ceiling. An ephemeral-storage limit here also caps the /tmp emptyDir at the same sizeLimit.",
          "properties": {
            "cpu": {
              "description": "Kubernetes quantity (500m, \"2.5\", 1e3) or a bare number of cores (4). \"\" omits the key.",
              "anyOf": [
                { "type": "number", "minimum": 0 },
                { "type": "string", "pattern": "^([0-9]+(\\.[0-9]*)?|\\.[0-9]+)([eE][-+]?[0-9]+|Ki|Mi|Gi|Ti|Pi|Ei|n|u|m|k|M|G|T|P|E)?$" },
                { "const": "" }
              ]
            },
            "memory": {
              "description": "Kubernetes quantity (4Gi, 512Mi, .5Gi) or a bare number, which Kubernetes reads as bytes. \"\" omits the key.",
              "anyOf": [
                { "type": "number", "minimum": 0 },
                { "type": "string", "pattern": "^([0-9]+(\\.[0-9]*)?|\\.[0-9]+)([eE][-+]?[0-9]+|Ki|Mi|Gi|Ti|Pi|Ei|n|u|m|k|M|G|T|P|E)?$" },
                { "const": "" }
              ]
            },
            "ephemeral-storage": {
              "description": "Kubernetes quantity (16Gi, 512Mi) or a bare number, which Kubernetes reads as bytes. \"\" omits the key.",
              "anyOf": [
                { "type": "number", "minimum": 0 },
                { "type": "string", "pattern": "^([0-9]+(\\.[0-9]*)?|\\.[0-9]+)([eE][-+]?[0-9]+|Ki|Mi|Gi|Ti|Pi|Ei|n|u|m|k|M|G|T|P|E)?$" },
                { "const": "" }
              ]
            }
          },
          "patternProperties": {
            "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/[A-Za-z0-9]([-_.A-Za-z0-9]*[A-Za-z0-9])?$": { "type": ["string", "number"], "minLength": 1 },
            "^hugepages-[0-9]+[KMGT]i$": { "type": ["string", "number"], "minLength": 1 }
          }
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "description": "Probe timing fields. The probe targets are deliberately not values: readiness and liveness must GET /health and the startup probe is the exec /api/health sidecar wait (#402 B4). startup has no initialDelaySeconds — absent renders nothing and the API defaults it to 0.",
      "properties": {
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["periodSeconds", "timeoutSeconds", "failureThreshold", "successThreshold"],
          "properties": {
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "timeoutSeconds": { "type": "integer", "minimum": 1 },
            "failureThreshold": { "type": "integer", "minimum": 1 },
            "successThreshold": { "type": "integer", "enum": [1], "description": "Kubernetes requires 1 for startup and liveness probes." }
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold", "successThreshold"],
          "properties": {
            "initialDelaySeconds": { "type": "integer", "minimum": 0 },
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "timeoutSeconds": { "type": "integer", "minimum": 1 },
            "failureThreshold": { "type": "integer", "minimum": 1 },
            "successThreshold": { "type": "integer", "minimum": 1, "description": "Readiness may require more than one consecutive success before a pod gets traffic." }
          }
        },
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold", "successThreshold"],
          "properties": {
            "initialDelaySeconds": { "type": "integer", "minimum": 0 },
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "timeoutSeconds": { "type": "integer", "minimum": 1 },
            "failureThreshold": { "type": "integer", "minimum": 1 },
            "successThreshold": { "type": "integer", "enum": [1], "description": "Kubernetes requires 1 for startup and liveness probes." }
          }
        }
      }
    },
    "env": {
      "type": "object",
      "properties": {
        "xdgDataHome": { "type": "string" },
        "xdgConfigHome": { "type": "string" },
        "secureCookies": { "type": "string" },
        "publicBaseUrl": { "type": "string" },
        "metadataRulesFile": { "type": "string" },
        "recordTranscripts": { "type": "boolean" },
        "sidecarTranscriptsDir": { "type": "string" }
      }
    },
    "tuning": {
      "type": "object",
      "properties": {
        "logLevel": { "type": "string" }
      }
    },
    "imageStream": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string" },
        "namespace": { "type": "string" }
      }
    },
    "tests": {
      "type": "object",
      "properties": {
        "image": { "type": "string" }
      }
    },
    "alerts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string" },
        "schedule": { "type": "string" },
        "envLabel": { "type": "string" },
        "metricsUrl": { "type": "string" },
        "image": { "type": "string" },
        "slackSecretName": { "type": "string" },
        "slackSecretKey": { "type": "string" },
        "errorRatePercent": {
          "type": ["integer", "null"],
          "description": "Deprecated: honoured as serverErrorPercent while that is unset. Use serverErrorPercent. Kept as loose as it shipped, so an out-of-range legacy value still deploys."
        },
        "serverErrorPercent": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100
        },
        "clientErrorPercent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "clientErrorMinRequests": {
          "type": "integer",
          "minimum": 1
        },
        "diskWarnPercent": { "type": "integer" },
        "diskCritPercent": { "type": "integer" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object", "description": "Free-form Kubernetes affinity block, rendered verbatim by the chart; not validated." }
  }
}
